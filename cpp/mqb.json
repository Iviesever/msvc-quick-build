{
  "version": 1,
  "build": {
    "configuration": "release",
    "architecture": "x64",
    "standard": "23",
    "type": "exe",
    "runtime": "MT",
    "subsystem": "console",
    "output": "mqb",
    "include_dirs": [
      "include",
      "src/app"
    ],
    "compiler_args": [
      "/W4",
      "/permissive-"
    ]
  },
  "discovery": {
    "enabled": true,
    "exclude_dirs": [
      "tests"
    ],
    "extra_sources": [
      "src/app/Application.cpp",
      "src/app/Cli.cpp",
      "src/app/Diagnostics.cpp",
      "src/app/Invocation.cpp",
      "src/app/ModuleCliTarget.cpp",
      "src/app/ProjectSetup.cpp",
      "src/app/StaticCliTarget.cpp",
      "src/msvc/MsvcCompileExecutor.cpp",
      "src/msvc/MsvcCompiler.cpp",
      "src/msvc/MsvcLibrarian.cpp",
      "src/msvc/MsvcLibraryResolver.cpp",
      "src/msvc/MsvcLinker.cpp",
      "src/msvc/MsvcModuleDependencyScanner.cpp",
      "src/msvc/MsvcSourceDependenciesReader.cpp",
      "src/msvc/MsvcToolchainLocator.cpp",
      "src/config/ProjectConfig.cpp",
      "src/config/ProjectOptions.cpp",
      "src/core/ArchiveCache.cpp",
      "src/core/ArchiveCacheFile.cpp",
      "src/core/BuildPlanner.cpp",
      "src/core/BuildSignature.cpp",
      "src/core/BuildTypes.cpp",
      "src/core/CompileCache.cpp",
      "src/core/CompileCacheFile.cpp",
      "src/core/DependencyGraph.cpp",
      "src/core/LinkCache.cpp",
      "src/core/LinkCacheFile.cpp",
      "src/core/ProjectArtifactLayout.cpp",
      "src/core/TranslationUnitClassifier.cpp",
      "src/discovery/ModuleSyntax.cpp",
      "src/discovery/SourceDiscovery.cpp",
      "src/json/Json.cpp",
      "src/modules/ModuleDependencyGraph.cpp",
      "src/modules/P1689.cpp",
      "src/orchestration/BoundedWorkScheduler.cpp",
      "src/orchestration/MsvcIncrementalArchiveCoordinator.cpp",
      "src/orchestration/MsvcIncrementalCompileCoordinator.cpp",
      "src/orchestration/MsvcIncrementalLinkCoordinator.cpp",
      "src/orchestration/MsvcIncrementalStaticTargetCoordinator.cpp",
      "src/orchestration/MsvcIncrementalTargetCoordinator.cpp",
      "src/orchestration/MsvcModuleCompileCoordinator.cpp",
      "src/orchestration/MsvcModuleTargetCoordinator.cpp",
      "src/orchestration/MsvcTargetRouter.cpp",
      "src/platform/windows/CommandLine.cpp",
      "src/platform/windows/WindowsProcessRunner.cpp"
    ]
